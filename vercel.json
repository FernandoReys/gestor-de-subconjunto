{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/state.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/auth.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/desktop-sync.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/calendar-export.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/runtime.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/support.js",
      "use": "@vercel/node"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true
}
